# Expense Tracker environment example
# Copy these values into your hosting provider or set them in PowerShell.

# Required for production. Generate a long random value.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Optional. If not set, the app stores an API key in SQLite.
EXPENSE_TRACKER_API_KEY=replace-with-a-long-random-api-key

# Optional AI features. Leave blank if you do not want paid AI parsing.
OPENAI_API_KEY=
OPENAI_SMS_MODEL=gpt-5-mini
OPENAI_CATEGORY_MODEL=gpt-5-mini

# Local/dev defaults.
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Use 1 only when the app is served through HTTPS.
SESSION_COOKIE_SECURE=0

# Optional production paths. Defaults are beside app.py.
DATABASE_PATH=C:\path\to\expense_tracker.db
BACKUP_DIR=C:\path\to\expense-tracker-backups
